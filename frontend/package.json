{
  "name": "empi-erp-frontend",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "start": "node .output/server/index.mjs",
    "lint": "nuxt typecheck",
    "test": "nuxt prepare && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.0.0",
    "@pinia/nuxt": "^0.11.0",
    "nuxt": "^4.0.0",
    "pinia": "^3.0.0",
    "sass": "^1.77.8",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "happy-dom": "^14.12.3",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "vue-tsc": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
